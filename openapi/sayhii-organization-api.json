            "description" : "The number of users successfully processed",
            "format" : "int32"
          },
          "message" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "description" : "A list of errors encountered during processing",
            "items" : {
              "type" : "object",
              "properties" : {
                "error" : {
