      },
      "UserSchema" : {
        "required" : [ "email", "id" ],
        "type" : "object",
        "properties" : {
          "lastName" : {
            "type" : "string",
            "description" : "The last name of the user"
          },
          "role" : {
            "type" : "string",
            "description" : "The role of the user"
          },
          "race" : {
            "type" : "string",
            "description" : "The race of the user"
          },
          "ethnicity" : {
            "type" : "string",
            "description" : "The ethnicity of the user"
          },
          "gender" : {
            "type" : "string",
            "description" : "The gender of the user"
          },
          "managerGuid" : {
            "type" : "string",
            "description" : "The unique identifier for the user's manager."
          },
          "hireYearAndMonth" : {
            "type" : "string",
            "description" : "The year and month when the employee was hired in the format YYYY.MM"
          },
          "firstName" : {
            "type" : "string",
            "description" : "The first name of the user"
          },
          "managerEmail" : {
            "type" : "string",
            "description" : "The email address of the user's manager. This will be used to build a reporting/management hierarchy."
          },
          "jobFunction" : {
            "type" : "string",
            "description" : "The job function of the user"
          },
          "workType" : {
            "type" : "string",
            "description" : "The work type of the user"
          },
          "guid" : {
            "type" : "string",
            "description" : "An alternate identifier for the user."
          },
          "disabled" : {
            "type" : "boolean",
            "description" : "The disabled status of the user. Disabled users cannot log in or access the system. The default is false."
          },
          "portalQuestions" : {
            "type" : "boolean",
            "description" : "Boolean indicating whether the user should receive/answer questions in the sayhii portal. The default is false."
          },
          "id" : {
            "type" : "string",
            "description" : "A unique identifier for the user. This must be unique within the organization and consistent across updates."
          },
          "department" : {
            "type" : "string",
            "description" : "The department of the user. This will be used to help group users for reporting."
          },
          "terminated" : {
            "type" : "string",
            "description" : "The termination status of the user (Y - the user has been terminated, N - the user is active)."
          },
          "workingZipCode" : {
            "type" : "string",
            "description" : "The working zip code of the user"
          },
          "email" : {
            "type" : "string",
            "description" : "The email address of the user, this must be unique within the organization"
          },
          "yearOfBirth" : {
            "type" : "string",
            "description" : "The year of birth of the user"
          }
        }
